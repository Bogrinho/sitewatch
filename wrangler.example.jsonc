{
  "name": "sitewatch",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "vars": { "DASHBOARD_USER": "sitewatch", "SMTP_USER": "your-email@example.com" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "sitewatch", "database_id": "REPLACE_WITH_YOUR_DATABASE_ID" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
